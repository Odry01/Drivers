# .gitignore file
#
# Set up for Microchip/MPLAB X development
# MPLAB X .gitignore New File generation
# 
# Needs to be located in the project folder
# project.X/.gitignore

# MPLAB X IDE specific
~*.*
/build/
/debug/
/dist/
/.generated_files/
/nbproject/private/
/nbproject/*.mk
/nbproject/*.bash
/nbproject/Makefile-genesis.properties

# Large Files
*.exe
*.zip
*.pdf